# Canonical origin for production metadata, sitemap, schema and social URLs.
# Configure the same value in Vercel, then rebuild/redeploy.
NEXT_PUBLIC_SITE_URL=https://theblessedwomb.in

# Keep the existing GTM container ID when changing the preferred hostname.
NEXT_PUBLIC_GTM_ID=

# Optional existing ownership-verification values; a host change does not
# require replacing the verification for a Search Console Domain property.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# Contact form: server-only values. Never prefix these with NEXT_PUBLIC_.
# Create a sending API key at https://resend.com/api-keys.
RESEND_API_KEY=
# Must use a domain verified in Resend. Example after verifying theblessedwomb.in:
CONTACT_FROM_EMAIL=The Blessed Womb <enquiries@theblessedwomb.in>
# One recipient keeps each enquiry to one email against the free quota.
# Multiple recipients can be comma-separated; each counts toward the quota.
CONTACT_TO_EMAIL=drjyoticares@gmail.com
